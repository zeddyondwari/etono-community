import express from 'express'
import cors from 'cors'
import fs from 'fs'
import path from 'path'
import { fileURLToPath } from 'url'

const app = express()
const port = 4000
const __filename = fileURLToPath(import.meta.url)
const __dirname = path.dirname(__filename)
const dbPath = path.join(__dirname, '..', 'data', 'db.json')

const ensureDb = () => {
  if (!fs.existsSync(dbPath)) {
    const defaultData = {
      users: [],
      campaigns: [
        {
          id: 1,
          title: 'School support fundraiser',
          description: 'Helping 120 students with school fees and educational materials.',
          target: 640000,
          raised: 460000,
          createdBy: 'Nia Health',
          tags: ['Education', 'Students'],
          status: 'active',
        },
        {
          id: 2,
          title: 'Community clean-up project',
          description: 'We are raising funds to install bins and clean public spaces in the district.',
          target: 410000,
          raised: 238000,
          createdBy: 'City Builders',
          tags: ['Environment', 'Public'],
          status: 'active',
        },
        {
          id: 3,
          title: 'Youth skills incubation fund',
          description: 'Startup support and training for emerging founders and creators.',
          target: 1200000,
          raised: 970000,
          createdBy: 'Makafio Hub',
          tags: ['Innovation', 'Startups'],
          status: 'active',
        },
      ],
    }

    fs.mkdirSync(path.dirname(dbPath), { recursive: true })
    fs.writeFileSync(dbPath, JSON.stringify(defaultData, null, 2))
  }
}

const readDb = () => {
  ensureDb()
  return JSON.parse(fs.readFileSync(dbPath, 'utf8'))
}

const writeDb = (data) => {
  fs.writeFileSync(dbPath, JSON.stringify(data, null, 2))
}

app.use(cors())
app.use(express.json())

app.get('/api/health', (req, res) => {
  res.json({ ok: true, message: 'ETONO COMMUNITY backend is running.' })
})

app.post('/api/auth/login', (req, res) => {
  const { name, email, password } = req.body || {}

  if (!name || !email || !password) {
    return res.status(400).json({ message: 'Name, email, and password are required.' })
  }

  const db = readDb()

  let user = db.users.find((entry) => entry.email.toLowerCase() === email.toLowerCase())

  if (!user) {
    user = {
      id: Date.now(),
      name,
      email,
      password,
      role: 'member',
      joinedAt: new Date().toISOString(),
    }

    db.users.push(user)
    writeDb(db)
  }

  const safeUser = {
    id: user.id,
    name: user.name,
    email: user.email,
    role: user.role,
    joinedAt: user.joinedAt,
  }

  res.json({ user: safeUser, message: 'Login successful' })
})

app.get('/api/funding/campaigns', (req, res) => {
  const db = readDb()
  const campaigns = db.campaigns.map((campaign) => ({
    ...campaign,
    progress: Math.min(100, Math.round((campaign.raised / campaign.target) * 100)),
    targetText: `₦${campaign.target.toLocaleString()}`,
    raisedText: `₦${campaign.raised.toLocaleString()}`,
  }))

  res.json({ campaigns })
})

app.post('/api/funding/campaigns', (req, res) => {
  const { title, description, target, createdBy, tags } = req.body || {}

  if (!title || !description || !target || !createdBy) {
    return res.status(400).json({ message: 'Campaign title, description, target, and creator are required.' })
  }

  const db = readDb()
  const newCampaign = {
    id: Date.now(),
    title,
    description,
    target: Number(target),
    raised: 0,
    createdBy,
    tags: Array.isArray(tags) && tags.length ? tags : ['Community'],
    status: 'active',
  }

  db.campaigns.unshift(newCampaign)
  writeDb(db)

  res.status(201).json({ campaign: newCampaign, message: 'Campaign created successfully.' })
})

app.post('/api/funding/contribute', (req, res) => {
  const { campaignId, amount, memberName } = req.body || {}

  if (!campaignId || !amount || !memberName) {
    return res.status(400).json({ message: 'Campaign ID, amount, and member name are required.' })
  }

  const db = readDb()
  const campaign = db.campaigns.find((entry) => entry.id === Number(campaignId))

  if (!campaign) {
    return res.status(404).json({ message: 'Campaign not found.' })
  }

  const contribution = Number(amount)
  campaign.raised = Number(campaign.raised || 0) + contribution

  writeDb(db)

  res.json({
    success: true,
    campaign,
    contribution,
    memberName,
    message: `${memberName} contributed ₦${contribution.toLocaleString()}.`,
  })
})

app.listen(port, () => {
  console.log(`ETONO COMMUNITY backend listening on http://localhost:${port}`)
})
